# Redireciona URLs antigas no formato /pagina/ (sem extensão) para o
# arquivo .html correspondente, quando ele existir. Mantém compatibilidade
# com links antigos (Google, favoritos, anúncios) do site anterior.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [R=301,L]
